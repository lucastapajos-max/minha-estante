# Cloudflare Pages/Workers — cabeçalhos

# --- Segurança (a CSP também vai no <meta> do index.html, pra valer mesmo
#     rodando local; mantenha os dois em sincronia ao mexer nas APIs) ---
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://*.supabase.co https://www.googleapis.com https://openlibrary.org https://covers.openlibrary.org https://brasilapi.com.br https://api.jikan.moe https://graphql.anilist.co https://api.mangabaka.org; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'

# O service worker não pode ficar preso em cache, senão as atualizações não chegam.
/sw.js
  Cache-Control: no-cache

/manifest.webmanifest
  Content-Type: application/manifest+json
